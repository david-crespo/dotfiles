{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ghostty-tab-title hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ghostty-tab-title prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ghostty-tab-title hook"
          },
          {
            "type": "command",
            "command": "bun \"$HOME/repos/dotfiles/codex/cost.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
