{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex"
          },
          {
            "type": "command",
            "command": "bun \"$HOME/repos/dotfiles/codex/cost.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
