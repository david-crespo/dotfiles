{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex"
          },
          {
            "type": "command",
            "command": "bun \"$HOME/repos/dotfiles/codex/cost.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ah hook agent --harness codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
